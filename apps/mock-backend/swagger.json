{
  "openapi": "3.0.0",
  "info": {
    "title": "Mock Backend API",
    "version": "1.0.0",
    "description": "OpenAPI spec for the mock-backend used in development and testing."
  },
  "servers": [
    { "url": "https://lguproject-admin-1.onrender.com", "description": "Render deployment" },
    { "url": "http://localhost:4001", "description": "Local development" }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/directives/assigned": {
      "get": { "summary": "List directives", "responses": { "200": { "description": "Array of directives" } } },
      "post": {
        "summary": "Create a directive",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Directive" } } }
        },
        "responses": { "200": { "description": "Created directive" } }
      }
    },
    "/directives/{id}/acknowledge": {
      "post": {
        "summary": "Acknowledge a directive",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Acknowledged" } }
      }
    },
    "/messages": {
      "get": { "summary": "List messages", "responses": { "200": { "description": "Array of messages" } } },
      "post": {
        "summary": "Create a message",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } }
        },
        "responses": { "200": { "description": "Created message" } }
      }
    },
    "/messages/{id}": {
      "get": {
        "summary": "Get a message",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Message object" } }
      },
      "put": {
        "summary": "Update a message",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Message" } } }
        },
        "responses": { "200": { "description": "Updated" } }
      },
      "delete": {
        "summary": "Delete a message",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Directive": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "issued_by": { "type": "string" },
          "issued_by_role": { "type": "string" },
          "priority": { "type": "string", "enum": ["NORMAL", "URGENT"] },
          "deadline": { "type": ["string", "null"] },
          "requires_ack": { "type": "boolean" },
          "requires_proof": { "type": "boolean" }
        },
        "required": ["title", "issued_by", "priority", "requires_ack", "requires_proof"]
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "date": { "type": "string", "format": "date-time" }
        },
        "required": ["from", "to", "body"]
      }
    }
  }
}
