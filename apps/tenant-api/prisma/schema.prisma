generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/@prisma/client-tenant"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Lightweight key-value store for system-level config that must survive
/// container restarts (e.g. the registration key obtained during device pairing).
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Organization {
  code                String            @id
  name                String
  level               String
  emailDomain         String?
  customDomain        String?
  usesGoogleWorkspace Boolean           @default(false)
  status              String            @default("active")
  registrationKey     String            @unique
  createdAt           DateTime          @default(now())
  barangay            String?
  cityClassification  String?
  cityMunicipality    String?
  contactNumber       String?
  entityCategory      String?
  entityName          String?
  headOfOfficeName    String?
  officialEmail       String?
  province            String?
  psgcCode            String?           @unique
  region              String?
  sysadminEmail       String?
  sysadminName        String?
  geofenceLat         Float?
  geofenceLng         Float?
  geofenceRadius      Float?            @default(50)
  applications        ApplicationCase[]
  auditLogs           AuditLog[]
  citizens            CitizenUser[]
  departments         Department[]
  roles               Role[]
  invites             StaffInvite[]
  staff               StaffUser[]
  announcements       Announcement[]
}

model Role {
  id              String           @id @default(uuid())
  orgCode         String
  roleName        String
  isSystemDefault Boolean          @default(false)
  org             Organization     @relation(fields: [orgCode], references: [code])
  permissions     RolePermission[]
  staff           StaffUser[]

  @@index([orgCode])
}

model Module {
  id       String  @id
  label    String
  category String
  minLevel String?

  @@index([category])
}

model RolePermission {
  id         String    @id @default(uuid())
  roleId     String
  module     String
  canCreate  Boolean   @default(false)
  canDelete  Boolean   @default(false)
  canRead    Boolean   @default(false)
  canUpdate  Boolean   @default(false)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([divisionId])
}

model Department {
  id           String            @id @default(uuid())
  orgCode      String
  name         String
  category     String
  applications ApplicationCase[]
  org          Organization      @relation(fields: [orgCode], references: [code])
  divisions    Division[]
  staff        StaffUser[]

  @@index([orgCode])
}

model Division {
  id              String           @id @default(uuid())
  departmentId    String
  name            String
  department      Department       @relation(fields: [departmentId], references: [id])
  rolePermissions RolePermission[]

  @@index([departmentId])
}

model StaffUser {
  id                String                    @id @default(uuid())
  orgCode           String
  email             String
  authProvider      String                    @default("password")
  status            String                    @default("active")
  baseRole          String?
  departmentId      String?
  createdAt         DateTime                  @default(now())
  accessExpiry      DateTime?
  appointmentStatus String?
  name              String?
  office            String?
  officeOtherText   String?
  positionTitle     String?
  roleId            String?
  auditLogs         AuditLog[]
  employee          Employee?
  grants            PermissionGrant[]
  invitesSent       StaffInvite[]             @relation("InvitedBy")
  overrides         StaffPermissionOverride[]
  department        Department?               @relation(fields: [departmentId], references: [id])
  org               Organization              @relation(fields: [orgCode], references: [code])
  role              Role?                     @relation(fields: [roleId], references: [id])
  credentials       StaffUserCredentials?
  announcements     Announcement[]
  attendanceLogs    AttendanceLog[]
  payrolls          Payroll[]
  leaveRequests     LeaveRequest[]            @relation("LeaveRequester")
  approvedLeaves    LeaveRequest[]            @relation("LeaveApprover")

  @@index([orgCode])
}

model StaffUserCredentials {
  id           String    @id @default(uuid())
  staffUserId  String    @unique
  staffUser    StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StaffPermissionOverride {
  id          String    @id @default(uuid())
  staffUserId String
  module      String
  canCreate   Boolean   @default(false)
  canDelete   Boolean   @default(false)
  canRead     Boolean   @default(false)
  canUpdate   Boolean   @default(false)
  divisionId  String?
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId])
}

model StaffInvite {
  id          String       @id @default(uuid())
  orgCode     String
  email       String
  invitedById String
  status      String       @default("pending")
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  invitedBy   StaffUser    @relation("InvitedBy", fields: [invitedById], references: [id])
  org         Organization @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
}

model Employee {
  id          String    @id @default(uuid())
  staffUserId String    @unique
  position    String
  dateHired   DateTime
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])
}

model PermissionGrant {
  id          String    @id @default(uuid())
  staffUserId String
  permission  String
  scopeType   String
  scopeId     String
  createdAt   DateTime  @default(now())
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id])
}

model CitizenUser {
  id                String            @id @default(uuid())
  orgCode           String
  email             String?           @unique
  phone             String?           @unique
  passwordHash      String
  fullName          String
  verificationLevel String            @default("unverified")
  philsysNumberHash String?           @unique
  createdAt         DateTime          @default(now())
  applications      ApplicationCase[]
  org               Organization      @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
}

model ServiceType {
  code                 String            @id
  name                 String
  category             String
  requiresVerification Boolean           @default(false)
  applications         ApplicationCase[]
}

model ApplicationCase {
  id                   String       @id @default(uuid())
  orgCode              String
  citizenId            String
  serviceTypeCode      String
  status               String       @default("submitted")
  assignedDepartmentId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  assignedDepartment   Department?  @relation(fields: [assignedDepartmentId], references: [id])
  citizen              CitizenUser  @relation(fields: [citizenId], references: [id])
  org                  Organization @relation(fields: [orgCode], references: [code])
  serviceType          ServiceType  @relation(fields: [serviceTypeCode], references: [code])

  @@index([orgCode])
}

model AuditLog {
  id         String        @id @default(uuid())
  orgCode    String?
  actorId    String?
  actorEmail String
  action     String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime      @default(now())
  actor      StaffUser?    @relation(fields: [actorId], references: [id])
  org        Organization? @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
  @@index([actorId])
}

// --- Features from common.md ---

model Announcement {
  id         String   @id @default(uuid())
  orgCode    String
  title      String
  content    String
  authorId   String
  targetType String   @default("all") // e.g. "all", "office", "department"
  targetId   String? // e.g. departmentId if targetType is "department"
  createdAt  DateTime @default(now())

  author StaffUser    @relation(fields: [authorId], references: [id])
  org    Organization @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
}

model AttendanceLog {
  id          String   @id @default(uuid())
  staffUserId String
  status      String // "online", "offline", "absent", "excused"
  latitude    Float?
  longitude   Float?
  timestamp   DateTime @default(now())
  notes       String?

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId])
  @@index([status])
}

model Payroll {
  id          String   @id @default(uuid())
  staffUserId String
  periodStart DateTime
  periodEnd   DateTime
  basePay     Float
  deductions  Float    @default(0)
  netPay      Float
  status      String   @default("pending") // "pending", "paid"
  createdAt   DateTime @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([staffUserId])
}

model LeaveRequest {
  id             String   @id @default(uuid())
  staffUserId    String
  type           String // "formal_leave", "field_work"
  reason         String
  startDate      DateTime
  endDate        DateTime
  status         String   @default("pending") // "pending", "approved", "rejected"
  medicalCertUrl String? // for formal leave if medical
  approvedById   String?
  createdAt      DateTime @default(now())

  staffUser  StaffUser  @relation("LeaveRequester", fields: [staffUserId], references: [id])
  approvedBy StaffUser? @relation("LeaveApprover", fields: [approvedById], references: [id])

  @@index([staffUserId])
}
