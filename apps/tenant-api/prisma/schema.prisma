generator client {
  provider     = "prisma-client-js"
  output       = "../node_modules/@prisma/client-tenant"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================================
// TENANT / ORGANIZATION
// One row per municipality/LGU. Everything else is scoped under orgCode.
// =========================================================================

/// Lightweight key-value store for system-level config that must survive
/// container restarts. Holds the central-server pairing state for this
/// physical device — the registration key and pairing token obtained
/// during initial setup, and the device's own identity as known to
/// central (e.g. keys: "central.registrationKey", "central.deviceId",
/// "central.certFingerprint", "central.lastHeartbeatSentAt"). This is
/// the local mirror of the row central's Devices/Licenses tables hold
/// for this tenant — central never pushes staff data down; this table
/// only ever holds this server's own connection credentials.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Organization {
  code                String   @id
  name                String
  level               String // "municipality" | "city" | "province"
  entityCategory      String?
  entityName          String?
  cityMunicipality    String?
  cityClassification  String? // income class, relevant to org chart size (see Division notes)
  province            String?
  region              String?
  barangay            String?
  psgcCode            String?  @unique
  headOfOfficeName    String?
  officialEmail       String?
  sysadminName        String?
  sysadminEmail       String?
  contactNumber       String?
  emailDomain         String?
  customDomain        String?
  usesGoogleWorkspace Boolean  @default(false)
  status              String   @default("active")
  registrationKey     String   @unique
  createdAt           DateTime @default(now())

  // Default geofence used only if an office/division doesn't define its own zone.
  geofenceLat    Float?
  geofenceLng    Float?
  geofenceRadius Float? @default(50)

  offices              Office[]
  roles                Role[]
  staff                StaffUser[]
  invites              StaffInvite[]
  citizens             CitizenUser[]
  applications         ApplicationCase[]
  auditLogs            AuditLog[]
  announcements        Announcement[]
  geofenceZones        GeofenceZone[]
  attachments          Attachment[]
  officeTabAllocations OfficeTabAllocation[]
}

// =========================================================================
// ORG STRUCTURE
// Office = mandated department (HRMO, MISO, Mayor's Office...). Division is
// an optional internal section (e.g. Records under HRMO) — only cities and
// higher-income-class municipalities tend to formalize these; smaller LGUs
// can leave a single Office with no divisions.
// =========================================================================

model Office {
  id       String       @id @default(uuid())
  orgCode  String
  name     String
  category String // "HRIS" | "MISO" | "Mayor" | ... — matches Tab.officeCategory
  org      Organization @relation(fields: [orgCode], references: [code])

  divisions            Division[]
  staff                StaffUser[]
  applications         ApplicationCase[]
  geofenceZones        GeofenceZone[]
  officeTabAllocations OfficeTabAllocation[]

  @@unique([orgCode, category])
  @@index([orgCode])
}

model Division {
  id       String @id @default(uuid())
  officeId String
  name     String // e.g. "Records", "Recruitment", "Payroll"
  office   Office @relation(fields: [officeId], references: [id])

  rolePermissions RoleTabPermission[]
  staff           StaffUser[]

  @@index([officeId])
}

// =========================================================================
// TAB CATALOG
// The backend-owned registry of every tab that exists in the codebase.
// New tabs are added here on deploy; MISO only allocates/activates,
// never creates.
// =========================================================================

model Tab {
  id               String   @id // e.g. "leave_approval", "payroll_processing"
  name             String
  officeCategory   String // which Office.category this tab is built for
  componentRef     String // frontend component/route key
  availableActions String[] // subset of: view, view_scoped, create, update, delete, approve, deny, export, sign
  version          String   @default("1.0.0")
  status           String   @default("active") // active | deprecated
  metadata         Json? // icon, description, changelog — non-queried extras
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  officeAllocations OfficeTabAllocation[]
  rolePermissions   RoleTabPermission[]
  overrides         StaffPermissionOverride[]

  @@index([officeCategory])
}

// Whether a tab is switched on for a specific office instance. This is the
// row MISO edits when allocating a tab — pure config, no code.
model OfficeTabAllocation {
  id            String   @id @default(uuid())
  orgCode       String
  officeId      String
  tabId         String
  isActive      Boolean  @default(true)
  allocatedById String
  allocatedAt   DateTime @default(now())

  org         Organization @relation(fields: [orgCode], references: [code])
  office      Office       @relation(fields: [officeId], references: [id])
  tab         Tab          @relation(fields: [tabId], references: [id])
  allocatedBy StaffUser    @relation("TabAllocator", fields: [allocatedById], references: [id])

  @@unique([officeId, tabId])
  @@index([orgCode])
}

// =========================================================================
// RBAC
// Role = template (e.g. "HRIS Staff", "HRIS Supervisor"). RoleTabPermission
// is the seeded matrix. StaffPermissionOverride stores only the diff from
// the assigned template, per employee.
// =========================================================================

model Role {
  id              String  @id @default(uuid())
  orgCode         String
  roleName        String
  officeCategory  String // which office type this template applies to
  isSystemDefault Boolean @default(false)

  org         Organization        @relation(fields: [orgCode], references: [code])
  permissions RoleTabPermission[]
  staff       StaffUser[]

  @@index([orgCode])
}

model RoleTabPermission {
  id            String  @id @default(uuid())
  roleId        String
  tabId         String
  divisionId    String?
  canRead       Boolean @default(false)
  canReadScoped Boolean @default(false) // "own records only" vs canRead = org/division-wide
  canCreate     Boolean @default(false)
  canUpdate     Boolean @default(false)
  canDelete     Boolean @default(false)
  canApprove    Boolean @default(false)
  canExport     Boolean @default(false)
  canSign       Boolean @default(false)

  role     Role      @relation(fields: [roleId], references: [id])
  tab      Tab       @relation(fields: [tabId], references: [id])
  division Division? @relation(fields: [divisionId], references: [id])

  @@unique([roleId, tabId])
  @@index([roleId])
}

// A recorded diff against the employee's role template. Only rows that
// actually diverge exist here — everything else inherits the template live,
// so editing a Role's permissions propagates automatically.
model StaffPermissionOverride {
  id            String   @id @default(uuid())
  staffUserId   String
  tabId         String
  canRead       Boolean?
  canReadScoped Boolean?
  canCreate     Boolean?
  canUpdate     Boolean?
  canDelete     Boolean?
  canApprove    Boolean?
  canExport     Boolean?
  canSign       Boolean?
  reason        String // required justification, shown in audit log
  grantedById   String
  createdAt     DateTime @default(now())

  staffUser StaffUser @relation("OverrideSubject", fields: [staffUserId], references: [id])
  tab       Tab       @relation(fields: [tabId], references: [id])
  grantedBy StaffUser @relation("OverrideGranter", fields: [grantedById], references: [id])

  @@unique([staffUserId, tabId])
  @@index([staffUserId])
}

// =========================================================================
// STAFF / AUTH
// =========================================================================

model StaffUser {
  id                     String    @id @default(uuid())
  orgCode                String
  officeId               String?
  divisionId             String?
  roleId                 String?
  employeeCode           String? // MISO-issued login ID, e.g. "EMP-0123" — null until provisioned
  employeeCodeIssuedAt   DateTime?
  employeeCodeIssuedById String?
  email                  String? // contact/notifications only — not used for login
  name                   String?
  positionTitle          String?
  appointmentStatus      String? // "permanent","casual","job order",...
  status                 String    @default("pending_provisioning") // pending_provisioning | active | suspended | separated
  accessExpiry           DateTime?
  createdAt              DateTime  @default(now())

  org                  Organization @relation(fields: [orgCode], references: [code])
  office               Office?      @relation(fields: [officeId], references: [id])
  division             Division?    @relation(fields: [divisionId], references: [id])
  role                 Role?        @relation(fields: [roleId], references: [id])
  employeeCodeIssuedBy StaffUser?   @relation("EmployeeCodeIssuer", fields: [employeeCodeIssuedById], references: [id])
  issuedEmployeeCodes  StaffUser[]  @relation("EmployeeCodeIssuer")

  employee            Employee?
  credentials         StaffUserCredentials?
  sessions            Session[]
  overrides           StaffPermissionOverride[] @relation("OverrideSubject")
  overridesGranted    StaffPermissionOverride[] @relation("OverrideGranter")
  tabAllocations      OfficeTabAllocation[]     @relation("TabAllocator")
  devices             Device[]                  @relation("DeviceOwner")
  devicesRegistered   Device[]                  @relation("DeviceRegisterer")
  biometricProfile    BiometricProfile?         @relation("BiometricOwner")
  biometricsEnrolled  BiometricProfile[]        @relation("BiometricEnroller")
  attachmentsUploaded Attachment[]
  auditLogs           AuditLog[]
  announcements       Announcement[]
  attendanceLogs      AttendanceLog[]
  payrolls            Payroll[]
  leaveRequests       LeaveRequest[]            @relation("LeaveRequester")
  approvedLeaves      LeaveRequest[]            @relation("LeaveApprover")
  invitesSent         StaffInvite[]             @relation("InvitedBy")

  @@unique([orgCode, employeeCode])
  @@unique([orgCode, email])
  @@index([orgCode])
}

// Public-facing HR record — created by HRIS on hire. Login credentials
// (employeeCode, password) are provisioned separately by MISO on StaffUser.
model Employee {
  id          String   @id @default(uuid())
  staffUserId String   @unique
  position    String
  dateHired   DateTime

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])
}

model StaffUserCredentials {
  id                  String    @id @default(uuid())
  staffUserId         String    @unique
  authProvider        String    @default("employee_id") // employee_id | google_workspace (SSO, opt-in per org)
  passwordHash        String?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(uuid())
  staffUserId      String
  refreshTokenHash String    @unique
  deviceId         String?
  relayLogId       String? // correlates to central's RelayConnectionLogs.relayLogId, if issued via the mobile relay
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  device    Device?   @relation(fields: [deviceId], references: [id])

  @@index([staffUserId])
}

model StaffInvite {
  id          String   @id @default(uuid())
  orgCode     String
  email       String
  invitedById String
  status      String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  invitedBy StaffUser    @relation("InvitedBy", fields: [invitedById], references: [id])
  org       Organization @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
}

// =========================================================================
// DEVICES & GEOFENCING (MISO-owned)
// =========================================================================

model Device {
  id             String    @id @default(uuid())
  staffUserId    String
  deviceUid      String    @unique // hardware/app-instance identifier
  deviceType     String // "mobile" | "kiosk" | "mini_pc"
  registeredById String
  status         String    @default("active") // active | lost | deactivated
  registeredAt   DateTime  @default(now())
  lastSeenAt     DateTime?

  staffUser      StaffUser       @relation("DeviceOwner", fields: [staffUserId], references: [id])
  registeredBy   StaffUser       @relation("DeviceRegisterer", fields: [registeredById], references: [id])
  sessions       Session[]
  attendanceLogs AttendanceLog[]

  @@index([staffUserId])
}

model GeofenceZone {
  id           String   @id @default(uuid())
  orgCode      String
  officeId     String?
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Float    @default(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  org    Organization @relation(fields: [orgCode], references: [code])
  office Office?      @relation(fields: [officeId], references: [id])

  attendanceLogs AttendanceLog[]

  @@index([orgCode])
}

// =========================================================================
// FILE STORAGE
// Two distinct concepts, kept in separate models on purpose:
//  - BiometricProfile: permanent, one active row per staff member, used for
//    facial-recognition auth. Stores a pointer to encrypted object storage
//    and a match embedding — never the raw enrollment image in this table.
//  - Attachment: temporary/general evidence (field work photos, medical
//    certs) with an explicit retention policy and optional expiry.
// =========================================================================

model BiometricProfile {
  id             String    @id @default(uuid())
  staffUserId    String    @unique
  storageKey     String // pointer into object storage (S3/GCS/etc), encrypted at rest
  embeddingHash  String? // derived match vector, not the raw image
  status         String    @default("active") // active | revoked | pending_reenrollment
  consentGivenAt DateTime?
  enrolledById   String
  enrolledAt     DateTime  @default(now())
  revokedAt      DateTime?

  staffUser  StaffUser @relation("BiometricOwner", fields: [staffUserId], references: [id])
  enrolledBy StaffUser @relation("BiometricEnroller", fields: [enrolledById], references: [id])
}

model Attachment {
  id              String    @id @default(uuid())
  orgCode         String
  uploadedById    String
  storageKey      String
  fileType        String // mime type
  purpose         String // "field_work_evidence" | "leave_medical_cert" | "other"
  latitude        Float?
  longitude       Float?
  retentionPolicy String    @default("temporary") // temporary | permanent
  expiresAt       DateTime?
  leaveRequestId  String?
  attendanceLogId String?
  createdAt       DateTime  @default(now())

  org           Organization   @relation(fields: [orgCode], references: [code])
  uploadedBy    StaffUser      @relation(fields: [uploadedById], references: [id])
  leaveRequest  LeaveRequest?  @relation(fields: [leaveRequestId], references: [id])
  attendanceLog AttendanceLog? @relation(fields: [attendanceLogId], references: [id])

  @@index([orgCode])
  @@index([leaveRequestId])
  @@index([attendanceLogId])
}

// =========================================================================
// ATTENDANCE
// =========================================================================

model AttendanceLog {
  id               String   @id @default(uuid())
  staffUserId      String
  deviceId         String?
  geofenceZoneId   String?
  status           String // "online" | "offline" | "absent" | "excused"
  latitude         Float?
  longitude        Float?
  geofenceVerified Boolean  @default(false)
  facialVerified   Boolean  @default(false)
  notes            String?
  timestamp        DateTime @default(now())

  staffUser    StaffUser     @relation(fields: [staffUserId], references: [id])
  device       Device?       @relation(fields: [deviceId], references: [id])
  geofenceZone GeofenceZone? @relation(fields: [geofenceZoneId], references: [id])
  attachments  Attachment[]

  @@index([staffUserId])
  @@index([status])
}

// =========================================================================
// LEAVE / FIELD WORK
// =========================================================================

model LeaveRequest {
  id           String   @id @default(uuid())
  staffUserId  String
  type         String // "formal_leave" | "field_work"
  reason       String
  startDate    DateTime
  endDate      DateTime
  status       String   @default("pending") // pending | approved | rejected
  approvedById String?
  createdAt    DateTime @default(now())

  staffUser   StaffUser    @relation("LeaveRequester", fields: [staffUserId], references: [id])
  approvedBy  StaffUser?   @relation("LeaveApprover", fields: [approvedById], references: [id])
  attachments Attachment[]

  @@index([staffUserId])
}

// =========================================================================
// PAYROLL — deductions broken into line items rather than one flat number,
// so the employee-facing breakdown tab has something to render.
// =========================================================================

model Payroll {
  id          String   @id @default(uuid())
  staffUserId String
  periodStart DateTime
  periodEnd   DateTime
  grossPay    Float
  netPay      Float
  status      String   @default("pending") // pending | paid
  createdAt   DateTime @default(now())

  staffUser  StaffUser          @relation(fields: [staffUserId], references: [id])
  deductions PayrollDeduction[]

  @@index([staffUserId])
}

model PayrollDeduction {
  id        String @id @default(uuid())
  payrollId String
  type      String // "GSIS" | "PhilHealth" | "Pag-IBIG" | "Withholding Tax" | "Loan"
  amount    Float

  payroll Payroll @relation(fields: [payrollId], references: [id])

  @@index([payrollId])
}

// =========================================================================
// CITIZEN-FACING (unchanged in shape, kept for completeness)
// =========================================================================

model CitizenUser {
  id                String   @id @default(uuid())
  orgCode           String
  email             String?  @unique
  phone             String?  @unique
  passwordHash      String
  fullName          String
  verificationLevel String   @default("unverified")
  philsysNumberHash String?  @unique
  createdAt         DateTime @default(now())

  org          Organization      @relation(fields: [orgCode], references: [code])
  applications ApplicationCase[]

  @@index([orgCode])
}

model ServiceType {
  code                 String            @id
  name                 String
  category             String
  requiresVerification Boolean           @default(false)
  applications         ApplicationCase[]
}

model ApplicationCase {
  id               String   @id @default(uuid())
  orgCode          String
  citizenId        String
  serviceTypeCode  String
  status           String   @default("submitted")
  assignedOfficeId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org            Organization @relation(fields: [orgCode], references: [code])
  citizen        CitizenUser  @relation(fields: [citizenId], references: [id])
  serviceType    ServiceType  @relation(fields: [serviceTypeCode], references: [code])
  assignedOffice Office?      @relation(fields: [assignedOfficeId], references: [id])

  @@index([orgCode])
}

// =========================================================================
// ANNOUNCEMENTS / AUDIT
// =========================================================================

model Announcement {
  id         String   @id @default(uuid())
  orgCode    String
  authorId   String
  title      String
  content    String
  targetType String   @default("all") // all | office
  targetId   String?
  createdAt  DateTime @default(now())

  author StaffUser    @relation(fields: [authorId], references: [id])
  org    Organization @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model AuditLog {
  id         String      @id @default(uuid())
  orgCode    String?
  actorId    String? // null on failed logins — no valid actor to reference
  actorEmail String
  action     String
  status     AuditStatus @default(SUCCESS)
  entityType String? // e.g. "OfficeTabAllocation", "StaffPermissionOverride"
  entityId   String?
  relayLogId String? // correlates to central's RelayConnectionLogs.relayLogId, if this request arrived via the mobile relay
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor StaffUser?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  org   Organization? @relation(fields: [orgCode], references: [code])

  @@index([orgCode])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action, status, createdAt])
}
