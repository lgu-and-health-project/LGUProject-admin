datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client-js"
  moduleFormat = "cjs"
}

enum AdminRole {
  ROOT_SUPERADMIN
  ADMIN
}

enum AdminStatus {
  INVITED
  PENDING_APPROVAL
  ACTIVE
  REVOKED
}

enum LguLevel {
  REGION
  PROVINCE
  CITY
  MUNICIPALITY
  BARANGAY
}

enum CityClassification {
  HUC
  ICC
  COMPONENT_CITY
}

enum TenantStatus {
  pending_setup
  active
  suspended
  deleted
}

enum LicenseStatus {
  active
  revoked
  expired
}

enum AuditAction {
  login
  invite_admin
  accept_invite
  delete_admin
  revoke_admin
  register_tenant
  suspend_tenant
  activate_tenant
  delete_tenant
  reissue_license
  revoke_license
  sync_psgc
}

enum AuditTargetType {
  tenant
  superadmin
  license
  session
  psgc
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum UserStatus {
  AWAITING_PROFILE
  ACTIVE
  UNVERIFIED
  VERIFIED
  INACTIVE
}

enum IdentifierType {
  EMAIL
  PHONE
}

// ====================================
// For Administrators/Registrations
// ====================================
model SuperAdmins {
  superadminId    String        @id @default(uuid()) @map("superadmin_id") @db.Uuid
  email           String        @unique
  fullName        String        @map("full_name")
  passwordHash    String        @map("password_hash")
  role            AdminRole
  status          AdminStatus
  appointedById   String?       @map("appointed_by_id") @db.Uuid
  appointedBy     SuperAdmins?  @relation("AdminAppointee", fields: [appointedById], references: [superadminId])
  appointees      SuperAdmins[] @relation("AdminAppointee")
  inviteTokenHash String?       @map("invite_token_hash")
  inviteExpiresAt DateTime?     @map("invite_expires_at") @db.Timestamptz
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz
  revokedById     String?       @map("revoked_by_id") @db.Uuid
  revokedBy       SuperAdmins?  @relation("AdminRevoker", fields: [revokedById], references: [superadminId])
  revoked         SuperAdmins[] @relation("AdminRevoker")
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  auditLogs             SuperAdminAuditLogs[]
  refreshTokens         RefreshTokens[]
  reviewedVerifications UserVerifications[]
}

model PsgcLocations {
  psgcLocationId     String          @id @default(uuid()) @map("psgc_location_id") @db.Uuid
  code               String          @unique
  psgcVersion        String          @map("psgc_version")
  areaName           String          @map("area_name")
  level              String
  cityClassification String?         @map("city_classification")
  parentId           String?         @map("parent_id") @db.Uuid
  parent             PsgcLocations?  @relation("LocationHierarchy", fields: [parentId], references: [psgcLocationId])
  children           PsgcLocations[] @relation("LocationHierarchy")

  geographicParentId String?         @map("geographic_parent_id") @db.Uuid
  geographicParent   PsgcLocations?  @relation("GeographicHierarchy", fields: [geographicParentId], references: [psgcLocationId])
  geographicChildren PsgcLocations[] @relation("GeographicHierarchy")
  supersededById     String?         @map("superseded_by_id") @db.Uuid
  supersededBy       PsgcLocations?  @relation("LocationSupersession", fields: [supersededById], references: [psgcLocationId])
  supersedes         PsgcLocations[] @relation("LocationSupersession")
  fetchedAt          DateTime        @default(now()) @map("fetched_at") @db.Timestamptz

  tenant    LguTenants[]
  addresses Addresses[]
}

enum SyncStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model PsgcSyncLogs {
  syncId       String     @id @default(uuid()) @map("sync_id") @db.Uuid
  psgcVersion  String     @map("psgc_version")
  status       SyncStatus @default(IN_PROGRESS)
  progress     Int        @default(0)
  totalRecords Int        @default(0) @map("total_records")
  trafficUsage Int        @default(0) @map("traffic_usage")
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz
  completedAt  DateTime?  @map("completed_at") @db.Timestamptz
  errorDetails String?    @map("error_details")
}

model LguTenants {
  tenantId           String        @id @default(uuid()) @map("tenant_id") @db.Uuid
  psgcLocationId     String        @unique @map("psgc_location_id") @db.Uuid
  psgcLocation       PsgcLocations @relation(fields: [psgcLocationId], references: [psgcLocationId])
  apiUrl             String?       @map("api_url")
  status             TenantStatus  @default(pending_setup)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz
  sysadminEmail      String        @map("sysadmin_email")
  sysadminVerifiedAt DateTime?     @map("sysadmin_verified_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  licenses Licenses[]
}

model Licenses {
  licenseId       String        @id @default(uuid()) @map("license_id") @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  tenant          LguTenants    @relation(fields: [tenantId], references: [tenantId])
  registrationKey String        @unique @map("registration_key")
  issuedAt        DateTime      @map("issued_at") @db.Timestamptz
  expiresAt       DateTime?     @map("expires_at") @db.Timestamptz
  status          LicenseStatus
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz
  revokedReason   String?       @map("revoked_reason")
}

model SuperAdminAuditLogs {
  adminAuditId String           @id @default(uuid()) @map("admin_audit_id") @db.Uuid
  // Nullable: a failed login against an email that doesn't belong to any
  // admin has no valid actor to reference, but is still worth logging
  // (brute-force/credential-stuffing detection).
  actorId      String?          @map("actor_id") @db.Uuid
  actor        SuperAdmins?     @relation(fields: [actorId], references: [superadminId])
  action       AuditAction
  status       AuditStatus      @default(SUCCESS)
  targetType   AuditTargetType? @map("target_type")
  targetId     String?          @map("target_id") @db.Uuid
  metadata     Json?
  ipAddress    String?          @map("ip_address")
  userAgent    String?          @map("user_agent")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt])
  @@index([action, status])
}

model RefreshTokens {
  refreshTokenId String      @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  tokenHash      String      @unique @map("token_hash")
  familyId       String      @map("family_id") @db.Uuid
  adminId        String      @map("admin_id") @db.Uuid
  admin          SuperAdmins @relation(fields: [adminId], references: [superadminId], onDelete: Cascade)
  isRevoked      Boolean     @default(false) @map("is_revoked")
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz
  ipAddress      String?     @map("ip_address")
  userAgent      String?     @map("user_agent")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
}

// ====================================
// For Users
// ====================================
model Users {
  userId    String     @id @default(uuid()) @map("user_id") @db.Uuid
  status    UserStatus
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  identifiers   UserIdentifiers[]
  credentials   UserCredentials[]
  profiles      UserProfiles[]
  verifications UserVerifications[]
}

model UserIdentifiers {
  identifierId    String         @id @default(uuid()) @map("identifier_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  user            Users          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  identifierType  IdentifierType @map("identifier_type")
  identifierValue String         @map("identifier_value")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz
}

model UserCredentials {
  credentialId String   @id @default(uuid()) @map("credential_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         Users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
}

model UserProfiles {
  profileId      String   @id @default(uuid()) @map("profile_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           Users    @relation(fields: [userId], references: [userId], onDelete: Cascade)
  firstName      String   @map("first_name")
  middleName     String?  @map("middle_name")
  lastName       String   @map("last_name")
  extensionName  String?  @map("extension_name")
  sex            String
  genderIdentity String?  @map("gender_identity")
  birthDate      DateTime @map("birth_date")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  addresses ProfileAddresses[]
}

model ProfileAddresses {
  profileAddressId String       @id @default(uuid()) @map("profile_address_id") @db.Uuid
  profileId        String       @map("profile_id") @db.Uuid
  profile          UserProfiles @relation(fields: [profileId], references: [profileId], onDelete: Cascade)
  addressId        String       @map("address_id") @db.Uuid
  address          Addresses    @relation(fields: [addressId], references: [addressId])
  type             String
  isPrimary        Boolean      @default(false) @map("is_primary") @db.Boolean
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz
}

model Addresses {
  addressId    String        @id @default(uuid()) @map("address_id") @db.Uuid
  psgcCode     String        @map("psgc_code")
  psgcLocation PsgcLocations @relation(fields: [psgcCode], references: [code])
  unitBuilding String?       @map("unit_building")
  street       String?
  zipCode      String?       @map("zip_code")
  latitude     Decimal?
  longitude    Decimal?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  profileAddress ProfileAddresses[]
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model UserVerifications {
  verificationId String             @id @default(uuid()) @map("verification_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  user           Users              @relation(fields: [userId], references: [userId], onDelete: Cascade)
  idType         String             @map("id_type")
  idNumber       String?            @map("id_number")
  idPhotoUrl     String             @map("id_photo_url")
  status         VerificationStatus @default(PENDING)
  submittedAt    DateTime           @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz
  reviewerId     String?            @map("reviewer_id") @db.Uuid
  reviewer       SuperAdmins?       @relation(fields: [reviewerId], references: [superadminId])
  remarks        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
}

model Otps {
  otpId          String         @id @default(uuid()) @map("otp_id") @db.Uuid
  identifier     String
  identifierType IdentifierType @map("identifier_type")
  code           String
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz
  isUsed         Boolean        @default(false) @map("is_used")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, code])
}
